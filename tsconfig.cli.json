{
  // TypeScript checks the CLI's plain JavaScript: no .ts files, nothing emitted, the paths people run and import stay
  // as they are. Types come from JSDoc and cli/globals.d.ts; what cli/ imports from dist/ is typed by the src/ it was
  // built from (dist/census.d.mts). npm run check runs this after tsconfig.json.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["cli/*.mjs", "cli/globals.d.ts"]
}
